# MoSJE Artisan Platform - Environment Configuration
# Project: SIH 2026 Problem Statement SIH26090

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="MoSJE AI Artisan Market Linkage Platform"
API_V1_STR=/api/v1

# Server-only security configuration. Set these in a secret manager; do not
# commit values to this file or deploy them to browser-visible variables.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
ADMIN_USER_IDS=
AADHAAR_PEPPER_KEY=

# Database (PostgreSQL 16 with PostGIS & pgvector)
# For local SQLite fallback (zero-Docker): sqlite+aiosqlite:///./artisan_platform.db
DATABASE_URL=
SYNC_DATABASE_URL=

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Services Configuration
# Set OFFLINE_MODE=true and MOCK_AI_SERVICES=true for air-gapped deterministic testing
OFFLINE_MODE=true
MOCK_AI_SERVICES=true

# External National AI Gateway Credentials (Optional in mock/offline mode)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
SARVAM_API_KEY=
OPENROUTER_API_KEY=

# Storage & File Uploads
STATIC_DIR=./static
UPLOAD_MAX_SIZE_MB=15
