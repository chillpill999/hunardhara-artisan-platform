# MoSJE Artisan Platform - Environment Configuration
# Project: SIH 2026 Problem Statement SIH26090

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="MoSJE AI Artisan Market Linkage Platform"
API_V1_STR=/api/v1

# Security & Tokens
SECRET_KEY=mosje_super_secret_jwt_key_sih2026_artisan_platform_replace_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AADHAAR_PEPPER_KEY=mosje_sovereign_aadhaar_pepper_secret_2026

# Database (PostgreSQL 16 with PostGIS & pgvector)
# For local SQLite fallback (zero-Docker): sqlite+aiosqlite:///./artisan_platform.db
DATABASE_URL=postgresql+asyncpg://artisan_admin:artisan_secure_password_2026@localhost:5432/artisan_platform
SYNC_DATABASE_URL=postgresql://artisan_admin:artisan_secure_password_2026@localhost:5432/artisan_platform

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Services Configuration
# Set OFFLINE_MODE=true and MOCK_AI_SERVICES=true for air-gapped deterministic testing
OFFLINE_MODE=true
MOCK_AI_SERVICES=true

# External National AI Gateway Credentials (Optional in mock/offline mode)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Storage & File Uploads
STATIC_DIR=./static
UPLOAD_MAX_SIZE_MB=15
