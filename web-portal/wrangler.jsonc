{
  "name": "hunardhara",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-08",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
